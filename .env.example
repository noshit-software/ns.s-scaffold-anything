# -------------------------------------------------------
# scaffold-anything — personal config
# Copy to .env and fill in your values
# -------------------------------------------------------

# GitHub orgs/accounts available when scaffolding
# Comma-separated, shown as a menu on invocation
SCAFFOLD_GITHUB_ORGS=your-username,your-org

# Local workspace directories per org (where repos get cloned)
# Format: SCAFFOLD_WORKSPACE_{ORG}=path  (hyphens in org name become underscores)
SCAFFOLD_WORKSPACE_your_username=C:/Users/you/workspace
SCAFFOLD_WORKSPACE_your_org=C:/Users/you/workspace-org

# Cloudflare — for subdomain creation on new projects
SCAFFOLD_CF_API_TOKEN=
# Zone ID and domain per org (hyphens in org name become underscores)
# Key format: SCAFFOLD_CF_ZONE_ID_{ORG} (hyphens → underscores)
SCAFFOLD_CF_ZONE_ID_robertgardunia=
SCAFFOLD_CF_DOMAIN_robertgardunia=knightsrook.com
SCAFFOLD_CF_ZONE_ID_noshit_software=
SCAFFOLD_CF_DOMAIN_noshit_software=noshit.software

# Server — for nginx + PM2 config generation
SCAFFOLD_SERVER_HOST=your.server.ip
SCAFFOLD_SERVER_USER=ubuntu
SCAFFOLD_SERVER_NGINX_SITES=/etc/nginx/sites-available
SCAFFOLD_SERVER_APPS_DIR=/opt
SCAFFOLD_SERVER_PM2_USER=ubuntu


# Port allocation — skill assigns next available port in each range
# Groupings keep services organized and avoid collisions
SCAFFOLD_PORT_RANGE_EXPRESS=5000-5099
SCAFFOLD_PORT_RANGE_FASTAPI=5100-5199
SCAFFOLD_PORT_RANGE_NEXTJS=5200-5299
SCAFFOLD_PORT_RANGE_VITE_DEV=5300-5399
